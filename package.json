{
  "name": "shady-pocket-space-escape",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4173",
    "render:animations": "LP_NUM_THREADS=4 blender --threads 4 --background --factory-startup --python-exit-code 1 --python tools/build_butter_model.py -- --render",
    "render:model-preview": "LP_NUM_THREADS=4 blender --threads 4 --background --factory-startup --python-exit-code 1 --python tools/build_butter_model.py -- --preview",
    "render:model-study": "LP_NUM_THREADS=4 blender --threads 4 --background --factory-startup --python-exit-code 1 --python tools/build_butter_study.py",
    "render:reference-model": "LP_NUM_THREADS=4 blender --threads 4 --background --factory-startup --python-exit-code 1 --python tools/build_butter_reference.py",
    "check:reference-model": "blender --background assets/models/butter-reference29.blend --python-exit-code 1 --python tools/check-butter-reference.py",
    "render:base-model": "LP_NUM_THREADS=4 MESA_SHADER_CACHE_DIR=/tmp/butter-mesa-cache blender --threads 4 --background --factory-startup --python-exit-code 1 --python tools/build_butter_base30.py",
    "check:base-model": "blender --threads 4 --background assets/models/butter-base30.blend --python-exit-code 1 --python tools/check-butter-base30.py",
    "render:aligned-model": "LP_NUM_THREADS=4 MESA_SHADER_CACHE_DIR=/tmp/butter-mesa-cache blender --threads 4 --background --factory-startup --python-exit-code 1 --python tools/build_butter_aligned31.py",
    "pack:model": "node tools/pack-butter-model.mjs",
    "pack:sprites": "node tools/pack-butter-sprites.mjs",
    "pack:motion": "node tools/pack-butter-model.mjs",
    "pack:legacy-motion": "node tools/pack-butter-motion.mjs",
    "pack:chibi": "node tools/pack-butter-chibi.mjs",
    "check:sprites": "node tools/check-butter-sprites.mjs",
    "check:butter-canon": "node tools/check-butter-canon.mjs",
    "check:butter-original": "node tools/check-butter-original.mjs",
    "check:platformer-art": "node tools/check-platformer-art.mjs",
    "test": "node --test"
  }
}
